# ============================================================
# WeRSS 部署环境变量
# 用法：cp .env.example .env 然后按注释填写
# 注意：本文件里的变量会全部注入 app 容器（config.yaml 用 ${VAR} 读取）
# ============================================================

# ---------- 必填：对外地址 ----------
# 反向代理后的公网地址，结尾不要带斜杠。
# 不填会让 RSS 里的链接变成 http://容器内网IP:8001/...，阅读器全部打不开。
RSS_BASE_URL=https://rss.example.com

# ---------- 必填：后台管理员 ----------
# 仅在 -init True 首次启动时创建；已存在则只把角色修正为 admin，不会改密码。
USERNAME=admin
PASSWORD=ChangeMe_2026

# ---------- 必填：数据库 ----------
# 密码请只用字母数字和 _ - ，避免 @ / : 破坏连接串
MYSQL_ROOT_PASSWORD=ChangeMe_root_2026
MYSQL_DATABASE=we_mp_rss
MYSQL_USER=rss_user
MYSQL_PASSWORD=ChangeMe_db_2026

# ---------- 会话密钥 ----------
# 生成方式：openssl rand -hex 32
SECRET_KEY=

# ---------- 运行参数 ----------
TZ=Asia/Shanghai
# ghcr 上只有 latest / 1.3.8 / 1.4.5 / beta 四个 tag，没有 1.5.x。
# 要锁版本请自己 build 后改成 we-mp-rss:opt（见 rss-opt/README.md）
# 国内拉取慢可换 docker.1ms.run/rachelos/we-mp-rss:latest
WERSS_IMAGE=ghcr.io/rachelos/we-mp-rss:latest
WERSS_PORT=8001
# 走反向代理时建议改成 127.0.0.1，避免 8001 直接暴露公网
WERSS_BIND=0.0.0.0
# Playwright 不适合多 worker，保持 1
THREADS=1
ENABLE_JOB=True
TOKEN_EXPIRE_MINUTES=4320
APP_MEMORY_LIMIT=2g
DB_MEMORY_LIMIT=1g
REDIS_MAXMEMORY=256mb

# ---------- RSS 行为 ----------
# 订阅链接指向本站文章页（True）还是原公众号链接（False）
RSS_LOCAL=True
# 输出全文（content:encoded）
RSS_FULL_CONTEXT=True
# 正文是否用 CDATA 包裹；阅读器渲染异常时可切 False
RSS_CDATA=False
# 是否带封面图
RSS_ADD_COVER=True
# 默认条数
RSS_PAGE_SIZE=30
# 单次返回上限
RSS_MAX_ITEMS=100
# 输出缓存有效期（秒）。0 = 永不过期，只靠采集后失效
RSS_CACHE_TTL=300
# 访问令牌，留空 = 公开可读（与上游一致）。公网部署强烈建议设置
RSS_ACCESS_TOKEN=
# 站点标题/描述/封面，留空用公众号自身信息
RSS_TITLE=
RSS_DESCRIPTION=
RSS_COVER=

# ---------- 采集 ----------
# 首次添加订阅时回补的页数，1 页约 5 篇
MAX_PAGE=5
# 每篇稿件之间的随机间隔上限（秒）
SPAN_INTERVAL=10
# 是否采集正文
GATHER_CONTENT=True
# 采集模式：web（永久链接）/ api（临时链接）/ app（最新消息）
GATHER_MODEL=web
# 自动补采缺失正文
GATHER_CONTENT_AUTO_CHECK=True
GATHER_CONTENT_AUTO_INTERVAL=59
# 浏览器内核，与镜像内安装的保持一致
BROWSER_TYPE=webkit

# ---------- 代理（可选） ----------
# 启用后需 docker compose --profile proxy up -d
PROXY_ENABLED=False
PROXY_HTTP_URL=http://singbox:7890
# socks5://user:pass@host:port 或 http://user:pass@host:port
PROXY_URL=
SINGBOX_LOG_LEVEL=warn

# ---------- 通知（可选） ----------
DINGDING_WEBHOOK=
WECHAT_WEBHOOK=
FEISHU_WEBHOOK=
CUSTOM_WEBHOOK=
# 登录态失效时是否推送二维码
SEND_CODE=False

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_FILE=
