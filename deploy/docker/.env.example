# 公众号 + RSS 服务部署变量
# 复制为 .env 后按需修改：cp .env.example .env

# ---------- 访问 ----------
PORT=5200
# 默认只绑本机，走 Nginx 反代；要局域网直连改成 0.0.0.0
BIND_ADDR=127.0.0.1
TZ=Asia/Shanghai

# ---------- 镜像形态 ----------
# 默认：公众号 + RSS（约 700MB，依赖 6 个，推荐长期跑）
DOCKERFILE=deploy/docker/Dockerfile
IMAGE=wechat-mp-tools-mp:latest
MEMORY_LIMIT=1g

# 切全功能版（加抖音/快手/小红书/B站/转码，约 1.6GB）时，把上面三行换成：
# DOCKERFILE=deploy/docker/Dockerfile.full
# IMAGE=wechat-mp-tools-full:latest
# MEMORY_LIMIT=2g

# 0 = 默认精简镜像（244MB / 拉取 51MB），无 Chromium、无 ffmpeg、无 playwright
#     公众号抓取、下载、RSS 全部可用；只有 PDF 导出和风控兜底不可用
# 1 = 带 Chromium（1.96GB / 拉取 536MB），PDF 导出可用
INSTALL_BROWSERS=0

# ---------- 路径 ----------
# 宿主机上数据目录对应的路径，只用于「打开文件夹」的提示文案
HOST_DATA_DIR=./data
# 可选：容器内下载目录，默认 /app/data/articles_full
# 迁移旧数据时，若 app_settings.json 里记的是别的机器路径（如 /Users/xxx/...），
# 该路径不存在会自动回落到这里，不用手工改配置
DOWNLOAD_DIR=

# ---------- RSS ----------
# 单次输出条数上限（阅读器可用 ?limit= 覆盖，最大 500）
# 0 = 不限制，和桌面版一致。实测 383 篇全量约 260 KB，一般不用限；
# 文章特别多（上千篇）或阅读器加载慢时，可设成 100 / 200
RSS_MAX_ITEMS=0
# 输出缓存秒数；0 表示不缓存
RSS_CACHE_TTL=300
# 访问令牌：留空 = 公开可读。对外部署务必设置，阅读器地址加 ?token=xxx
RSS_TOKEN=
# 订阅里生成的对外地址，例如 https://rss.example.com/
# 留空则按请求头推导（反代需正确传 X-Forwarded-Proto / X-Forwarded-Host）
RSS_BASE_URL=
# 将微信 / 微信读书头像缓存到 data/avatars；失败时回退远程地址
RSS_LOCAL_AVATAR=1
# 账号头像缺失时，从本地文章元数据或最近文章页面补全
RSS_AVATAR_FROM_ARTICLE=1

# ---------- 数据库存储引擎 (SQLite / MySQL) ----------
# 默认为 sqlite，零配置、零维护，数据文件持久化在 data/wechat_tools.db
DB_TYPE=sqlite

# 若切换为 MySQL，请配置下方参数并修改 DB_TYPE=mysql：
# 如果使用外部独立 MySQL 或群晖 NAS 上的数据库：
# DB_TYPE=mysql
# DB_HOST=192.168.1.100
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=wechat_tools

# 如果使用 docker-compose 自带的一键 MySQL 服务（执行 docker compose --profile with-mysql up -d 启动）：
# DB_TYPE=mysql
# DB_HOST=db
# DB_PORT=3306
# DB_USER=wechat
# DB_PASSWORD=wechat123456
# DB_NAME=wechat_tools
# DB_ROOT_PASSWORD=root123456

# ---------- 非 root 运行（可选） ----------
# 启用前先：sudo chown -R 1000:1000 ./data，并取消 compose 里 user: 的注释
PUID=1000
PGID=1000
